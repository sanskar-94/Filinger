{
  "base_model": "meta-llama/Llama-3.1-8B-Instruct",
  "qlora": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "learning_rate": 0.0001,
  "num_train_epochs": 2,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "max_length": 6144,
  "merge_after_training": false,
  "report_to": ["mlflow"]
}
