# Required by SEC fair access policy: organisation name and contact email
SEC_USER_AGENT="Your Org Name your.email@example.com"
FLAB_DATA_ROOT=./data
# s3://your-bucket/filings-lab when running on EMR or Databricks
FLAB_LAKE_ROOT=./data/lake
ANTHROPIC_API_KEY=
# Free alternative for the agent and for labelling: any OpenAI compatible chat API. NVIDIA's hosted endpoints are
# the default (a free key from build.nvidia.com); set the base URL and model to use another provider.
NVIDIA_API_KEY=
FLAB_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
FLAB_OPENAI_MODEL=meta/llama-3.3-70b-instruct
FLAB_LLM_BASE_URL=http://localhost:8000/v1
FLAB_LLM_MODEL=filings-extractor
MLFLOW_TRACKING_URI=./mlruns
